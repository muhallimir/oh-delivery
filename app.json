{
  "expo": {
    "name": "Oh Delivery",
    "slug": "oh-delivery",
    "scheme": "ohdelivery",
    "version": "1.0.0",
    "owner": "amirsali",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amirsali.ohdelivery"
    },
    "android": {
      "package": "com.amirsali.ohdelivery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "author": {
        "name": "Amirsali",
        "email": "mir23wpurposes@gmail.com",
        "github": "https://github.com/amirsali"
      },
      "description": "Food delivery app built with Expo and React Native",
      "license": "MIT"
    }
  }
}
